# VORTEXA PRODUCTION ENVIRONMENT VARIABLES

# ==========================================
# PHASE 1: DATABASE
# ==========================================
# The full PostgreSQL connection string. Must be a valid PG URI.
DATABASE_URL="postgresql://user:password@host:5432/vortexa_db?schema=public"

# ==========================================
# PHASE 2: AUTHENTICATION
# ==========================================
# 256-bit cryptographically secure string for signing JWT tokens
JWT_SECRET="generate-a-secure-random-string-here"

# ==========================================
# PHASE 3: APP METADATA
# ==========================================
# Base URL for the production deployment, used for absolute URLs and CORS
BASE_URL="https://vortexa.yourdomain.com"

# ==========================================
# PHASE 4: TRANSACTIONAL EMAIL (Nodemailer / Gmail)
# ==========================================
# Gmail Account address (e.g. airsociety.2026@gmail.com)
SMTP_USER="airsociety.2026@gmail.com"
# Gmail App Password (NOT your regular password)
SMTP_PASS="xxxx xxxx xxxx xxxx"
